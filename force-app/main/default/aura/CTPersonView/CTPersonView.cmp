<aura:component controller="CTPersonViewController">

    <!-- Attributes -->
    <aura:attribute name="recordId" type="String" />
    <aura:attribute name="status" type="String" />
    <aura:attribute name="fields" type="String[]"
        default="['Name','Health_Status__c','Mobile__c','Token__c','Status_Update_Date__c']" />

    <!-- handlers -->
    <aura:handler event="c.CTPersonSelect" action="{!c.handlePersonSelectEvent}" />

    <aura:if isTrue="{! !empty(v.recordId)}">
        <div class="{! 'person-card ' + v.status}">
            <lightning:layout multipleRows="true">
                <lightning:layoutItem size="12">
                    <lightning:recordForm recordId="{!v.recordId}" objectApiName="Person__c" fields="{!v.fields}" columns="1" mode="readonly" />
                </lightning:layoutItem>
                <aura:if isTrue="{! (v.status != 'Red')}">
                    <lightning:layoutItem size="12" padding="around-small">
                        <lightning:button label="Update Status To Red" title="Update Status To Red" onclick="{! c.handleUpdateStatusClick }" variant="destructive" />
                    </lightning:layoutItem>
                </aura:if>
            </lightning:layout>
        </div>
    </aura:if>

</aura:component>