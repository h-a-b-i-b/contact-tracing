<aura:component implements="force:appHostable" access="global">

    <!-- Attributes -->
    <aura:attribute name="selectedTabId" type="String" default="person" />
    <aura:attribute name="headerTitle" type="String" default="Person View" />
    <aura:attribute name="scope" type="String" default="person" />

    <div class="container">
        <lightning:layout multipleRows="true" class="main-component">
            <lightning:layoutItem size="12">
                <!-- Header section -->
                <c:CTHealthHeader headerTitle="{!v.headerTitle}" scope="{!v.scope}" aura:id="health-header"/>
            </lightning:layoutItem>
            <lightning:layoutItem size="12">
                <lightning:tabset variant="vertical" selectedTabId="{!v.selectedTabId}" onselect="{!c.tabSelectHandler}">
                    <lightning:tab label="Person View" id="person" >
                        <c:CTRecentChanges scope="{! v.scope }"/>
                    </lightning:tab>
                    <lightning:tab label="Location View" id="location">
                        <lightning:layout>
                            <lightning:layoutItem size="8" padding="horizontal-small">
                                <c:CTRecentChanges scope="{! v.scope }"/>
                            </lightning:layoutItem>
                            <lightning:layoutItem size="4" padding="horizontal-small">
                                <c:CTLocationView/>
                            </lightning:layoutItem>
                        </lightning:layout>
                    </lightning:tab>
                </lightning:tabset>

            </lightning:layoutItem>
        </lightning:layout>
    </div>
</aura:component>